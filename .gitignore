# Artefatos sensíveis que NÃO devem ir para o repo
.chunks/
*.tmp
*.bak
__pycache__/
*.pyc
.DS_Store
Thumbs.db

# Chaves e credenciais
*deploy_key*
*id_ed25519*
*.pem
.env

# The release signing key is generated and kept offline by the owner; it must never
# reach the repository (docs/AUTO-UPDATE.md).
*.release-secret

# .full.json são respostas brutas do MCP — duplicações dos .txt
*.full.json

# Manter JSONs individuais em binary_data/functions/ (são os artefatos úteis)
!binary_data/functions/*.json

Higurashi-Daybreak/

# Keep external reference bundles and generated analysis local. Reviewed code
# adaptations may be tracked with attribution; original game assets never are.
.local-analysis/

# Raw binary Evidence, captures and generated experiment reports.
local-data/harness/

# The PSP extraction: the player's own disc, converted for this port. Whole and in part it
# is the original rights holders' data, so only the file list in assets/psp/ is tracked.
psp-data/

# Generated research output; regenerate from decompiled/ and symbols/ when needed.
/research/recomp/

# Build outputs and fetched third-party sources. Both are produced by build.sh and
# fetch_deps.sh; a clean checkout has neither.
/build/
/third_party/

# Local leftovers under the retired remake/ tree: the old build outputs and the fetched
# toolchains. Nothing tracked lives here any more; the owner deletes these on disk.
/remake/

# Web asset delivery (issue #4). The prepared tree and its catalog are derived from the
# host's own game install: the tooling is committed, the data never is. `prepare` also
# writes a .gitignore into its own output directory, so a host who points --out
# somewhere else is covered without depending on this file.
/webdelivery/client/
/web-data/

# Editor-local settings
.vscode/
