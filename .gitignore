# Artefatos sensíveis que NÃO devem ir para o repo
.chunks/
*.tmp
*.bak
__pycache__/
*.pyc
.DS_Store
Thumbs.db

# Chaves e credenciais (se acidentalmente colocadas aqui)
*deploy_key*
*id_ed25519*
*.pem
.env

# Manter .full.json em binary_data/functions/ (são os JSONs completos das funções)
# Mas ignorar .full.json grandes que são duplicatas dos .txt
binary_data/*.full.json
binary_data/strings/*.full.json
binary_data/types/*.full.json
binary_data/callgraph/*.full.json
binary_data/segments/*.full.json
